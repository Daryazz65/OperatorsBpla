<Window x:Class="OperatorsBpla.View.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperatorsBpla.View.Windows"
        mc:Ignorable="d"
        Title="Главное окно администратора"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#131F24">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <StackPanel Background="#293B43">
            <Border Height="50"/>
            <Button HorizontalAlignment="Left" Margin="21 0 0 0" Height="26" x:Name="UserBtn" Click="UserBtn_Click"  Background="Transparent" BorderBrush="Transparent">
                <TextBlock Text="User" />
            </Button>
            <Border Height="17"/>
            <Button HorizontalAlignment="Left" Margin="20 0 0 0" Height="26" x:Name="UserLectureBtn" Click="UserLectureBtn_Click"  Background="Transparent" BorderBrush="Transparent" >
                <TextBlock Text="UserLecture" />
            </Button>
            <Border Height="17"/>
            <Button HorizontalAlignment="Left" Margin="20 0 0 0" Height="26" x:Name="QuestionUserBtn" Click="QuestionUserBtn_Click"  Background="Transparent" BorderBrush="Transparent" >
                <TextBlock Text="QuestionUser" />
            </Button>
            <Border Height="500"/>
            <Button Content="Выйти из аккаунта" Margin="10" 
                    Height="45" Name="GoOutBtn" Click="GoOutBtn_Click"/>
        </StackPanel>
        <Frame Name="MainFrameAdmin" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>