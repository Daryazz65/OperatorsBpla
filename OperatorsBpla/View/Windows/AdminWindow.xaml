<Window x:Class="OperatorsBpla.View.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperatorsBpla.View.Windows"
        mc:Ignorable="d"
        Title="Главное окно администратора"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid Background="#252525">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Source="/Resources/Group 4.png" HorizontalAlignment="Left" Width="80" Height="50" Margin="5" VerticalAlignment="Top"/>

            <StackPanel Margin="0 20 0 0">
                <Border Height="50"/>
                <Button HorizontalAlignment="Left" Margin="21 0 0 0" Height="26" x:Name="UserBtn" Click="UserBtn_Click"  Background="Transparent" BorderBrush="Transparent">
                    <TextBlock Text="Пользователи" />
                </Button>
                <Border Height="17"/>
                <Button HorizontalAlignment="Left" Margin="20 0 0 0" Height="26" x:Name="UserLectureBtn" Click="UserLectureBtn_Click"  Background="Transparent" BorderBrush="Transparent" >
                    <TextBlock Text="Ученики и лекции" />
                </Button>
                <Border Height="17"/>
                <Button HorizontalAlignment="Left" Margin="20 0 0 0" Height="26" x:Name="QuestionUserBtn" Click="QuestionUserBtn_Click"  Background="Transparent" BorderBrush="Transparent" >
                    <TextBlock Text="Ученики и вопросы " />
                </Button>
            </StackPanel>

            <Button Grid.Row="1" Content="Выйти из аккаунта" Margin="10" 
                    Height="45" Name="GoOutBtn" Click="GoOutBtn_Click" VerticalAlignment="Bottom"/>
        </Grid>

        <Frame Name="MainFrameAdmin" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>