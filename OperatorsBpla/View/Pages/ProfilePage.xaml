<Page x:Class="OperatorsBpla.View.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperatorsBpla.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Grid Background="#131F24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Width="760" Height="320" Background="#1E2A2E" CornerRadius="10" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Border Grid.Column="0" Background="#293B43" CornerRadius="8" Padding="16">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="110" Height="110" Fill="#203235" >
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#000" BlurRadius="6" ShadowDepth="2"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Name="AvatarTb" Text="AB" Foreground="White" FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="-86 -86 0 0"/>
                        <TextBlock Text="{Binding Fullname}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0 12 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Details -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Профиль пользователя" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0 0 0 12"/>

                    <StackPanel Orientation="Horizontal" Margin="0 4 0 4">
                        <TextBlock Text="ФИО:" Width="180" Foreground="#AFC6CA"/>
                        <TextBlock Text="{Binding Fullname}" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 4 0 4">
                        <TextBlock Text="Логин:" Width="180" Foreground="#AFC6CA"/>
                        <TextBlock Text="{Binding Login}" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 4 0 4">
                        <TextBlock Text="Дата регистрации:" Width="180" Foreground="#AFC6CA"/>
                        <TextBlock Text="{Binding RegistrationDate, StringFormat=d}" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 4 0 12">
                        <TextBlock Text="Роль:" Width="180" Foreground="#AFC6CA"/>
                        <TextBlock Text="{Binding Role.Name}" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                        <Border x:Name="CompletedBorder" Background="#203235" Padding="10" CornerRadius="6" Margin="0 0 12 0">
                            <StackPanel>
                                <TextBlock Text="Лекций завершено" Foreground="#AFC6CA" FontSize="12"/>
                                <TextBlock Name="CompletedCountTb" Text="0" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AnsweredBorder" Background="#203235" Padding="10" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Вопросов отвечено" Foreground="#AFC6CA" FontSize="12"/>
                                <TextBlock Name="AnsweredCountTb" Text="0" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
